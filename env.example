FLASK_APP=run.py
FLASK_ENV=development

# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=your-strong-password-here
DATABASE_URL=postgresql://kvitkova_user:your-strong-password-here@postgres:5432/kvitkova_crm

# Security
SECRET_KEY=your-secret-key-here

# Admin user (створюється через flask ensure-admin)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kvitkovapovnya.com
ADMIN_PASSWORD=your-admin-password-here

# Telegram bot (couriers)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Omnichannel inbox — SEPARATE Telegram bot connected to the shop's Telegram Business account
INBOX_TELEGRAM_BOT_TOKEN=8614939207:AAE5wyA2E6_z-rGhhvXufieG5aDL1dJ5Xx8
INBOX_MEDIA_MAX_BYTES=15728640
# Inbox media (photos/videos) older than this are deleted from disk daily
# (message text history is kept forever) — see scripts/run_media_cleanup.py
INBOX_MEDIA_RETENTION_DAYS=14

# Omnichannel inbox — Instagram (Instagram API with Instagram Login, graph.instagram.com)
INBOX_INSTAGRAM_ACCESS_TOKEN=
INBOX_INSTAGRAM_APP_SECRET=
INBOX_INSTAGRAM_GRAPH_VERSION=v23.0

# Omnichannel inbox — Telegram "personal number" channel (MTProto login via Telethon).
# App credentials from https://my.telegram.org (API development tools) — shared by all
# personal-number channels, not per-channel.
# WARNING: this logs in as a real personal Telegram account (not a bot). Telegram may
# limit/restrict accounts it flags as automated. Use a dedicated number, not your main one.
MESSAGING_TG_API_ID=
MESSAGING_TG_API_HASH=
# Fernet key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# used to encrypt the MTProto session string at rest in the database.
MESSAGING_SESSION_KEY=

# Route optimizer
ROUTE_OPTIMIZER_URL=http://your-optimizer-host:3000
OPTIMIZER_API_KEY=
DEPOT_ADDRESS=вулиця Хрещатик, 1, Київ

# Google Maps — address autocomplete in order/subscription forms.
# Needs "Places API (New)" enabled in Google Cloud Console (with billing).
GOOGLE_MAPS_API_KEY=

# short.io — shortens Google Maps route links in courier Telegram messages.
# Both required; without them the app falls back to is.gd, then the full URL.
SHORTIO_API_KEY=
SHORTIO_DOMAIN=

# Stadia Maps — basemap for the route optimizer map. Optional: keyless works on
# localhost and on domains allow-listed in the Stadia dashboard (free tier).
STADIA_API_KEY=

# AI Agent (OpenAI-compatible API)
AI_API_KEY=your-ai-api-key-here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

# Redis
REDIS_URL=redis://redis:6379/0
